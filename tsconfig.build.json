{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "types": ["react", "react-dom"]
  },
  "include": ["src/portal/**/*.ts", "src/portal/**/*.tsx", "src/data/**/*.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
