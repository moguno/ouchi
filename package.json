{
  "name": "ouchi-local-portal",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/ouchi-portal.js",
  "module": "./dist/ouchi-portal.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ouchi-portal.js"
    },
    "./styles.css": "./dist/ouchi-portal.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "ICON_LICENSES.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:mcp": "tsx watch mcp/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "build:pages": "vite build --mode pages --outDir pages-dist",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=server-dist/index.js --packages=external",
    "build:mcp": "esbuild mcp/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=mcp-dist/index.js --packages=external",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo && npm run build:server && npm run build:mcp",
    "start": "node server-dist/index.js",
    "start:mcp": "node mcp-dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.14.1",
    "esbuild": "0.28.2",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.12.14",
    "yaml": "^2.9.0"
  }
}
